#!/usr/bin/env bash
# Runs one command in the control container with the database passwords the
# arms and bin/zdt-fleet read, taken from the Compose secret files.
#
#   lab/zdt-fleet/bin/with-secrets bin/zdt-arm arm1 -n
#   lab/zdt-fleet/bin/with-secrets bin/zdt-fleet replica-check
#
# The passwords go into this process's environment and the command's, never
# into an argument, a file or the output. Nothing is changed; the command
# decides what it does.
set -euo pipefail

if [[ $# -eq 0 ]]; then
    echo "with-secrets: usage: with-secrets COMMAND [ARG...]" >&2
    exit 2
fi

secret_dir="${ZDT_SECRET_DIR:-/run/secrets}"
app_file="$secret_dir/db_app_password"
if [[ ! -r $app_file ]]; then
    echo "with-secrets: cannot read $app_file; run this inside the control container" >&2
    exit 2
fi

app_password="$(<"$app_file")"
export ZDT_DB_PASSWORD="$app_password"
export ZDT_PRIMARY_PASSWORD="$app_password"
export ZDT_REPLICA_PASSWORD="$app_password"
unset app_password

exec "$@"
