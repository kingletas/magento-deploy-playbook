#!/bin/bash
# Stands in for `php bin/magento`. Logs the subcommand and succeeds.
#
# `setup:db:status` and `app:config:status` are the two whose EXIT CODE the
# playbook branches on: 0 is up to date and 2 is work to do, as in Magento. Both
# report up to date here, so the default path is the no-upgrade path. Touch
# /tmp/magento-fake-needs-upgrade in the container to exercise the other branch;
# `bin/docker-suite test` does that for its last deploy.
#
# `maint:enable` and `maint:disable` write and remove var/.maintenance.flag in
# the release they run in, as Magento does, and log that directory.
needs_upgrade() { [ -e /tmp/magento-fake-needs-upgrade ]; }

case "$1" in
  maint:enable|maint:disable)
    echo "[fake-magento] $* in ${PWD}" >> /tmp/build-log 2>/dev/null || true ;;
  *)
    echo "[fake-magento] $*" >> /tmp/build-log 2>/dev/null || true ;;
esac

case "$1" in
  maint:enable)
    mkdir -p var && touch var/.maintenance.flag
    echo "Enabled maintenance mode"
    ;;
  maint:disable)
    rm -f var/.maintenance.flag
    echo "Disabled maintenance mode"
    ;;
  setup:upgrade)
    # config.php changed: Magento's config import asks for a yes, and without
    # --no-interaction and nobody to answer, it aborts.
    if [ -e /tmp/magento-fake-config-change ] && ! printf '%s\n' "$@" | grep -qx -- '--no-interaction'; then
      echo "The following themes will be registered: frontend/Acme/shop"
      echo "Do you want to continue [yes/no]?"
      echo "Import failed: Aborted."
      exit 1
    fi
    if [ -e /tmp/magento-fake-upgrade-fails ]; then
      echo "Unable to apply data patch Acme\\Shop\\Setup\\Patch\\Data\\Broken" >&2
      exit 1
    fi
    # One patch per upgrade with work to do, which magento-db-guard-fake reads.
    if needs_upgrade; then
      echo $(( $(cat /tmp/magento-fake-patch-id 2>/dev/null || echo 0) + 1 )) > /tmp/magento-fake-patch-id
    fi
    echo "Magento installation complete."
    ;;
  s:d:c|setup:di:compile)
    mkdir -p generated/code generated/metadata
    date +%s > generated/code/compiled-at
    echo "Generated code and dependency injection configuration successfully."
    ;;
  s:static-content:d|setup:static-content:deploy)
    # A release the fake storefront answers 500 for, to exercise the rollback.
    if [ -e /tmp/magento-fake-break-build ]; then
      mkdir -p pub && touch pub/fake-broken
    fi
    # Output shaped like Magento's, so static-verify.py has something to read.
    # /tmp/magento-fake-break-static makes the silent parallel failure: an
    # error in the output, a theme short of its files, and still exit 0.
    front=pub/static/frontend/Magento/luma/en_US admin=pub/static/adminhtml/Magento/backend/en_US
    mkdir -p "${front}/css" "${admin}/css" var/view_preprocessed/pub/static
    date +%s > pub/static/deployed_version.txt
    echo "styles" > "${front}/css/styles-l.css" && echo "styles" > "${admin}/css/styles.css"
    echo "adminhtml/Magento/backend/en_US          10/10           ============================ 100%"
    if [ -e /tmp/magento-fake-break-static ]; then
      echo "ParseError: missing closing \`}\` in _extend.less on line 1, column 8"
      echo "Error happened during deploy process: Compilation from source: styles-m.less"
      echo "frontend/Magento/luma/en_US             9/10            ==========================>- 90%"
    else
      echo "styles" > "${front}/css/styles-m.css"
      echo "frontend/Magento/luma/en_US             10/10           ============================ 100%"
    fi
    echo "Execution time: 1"
    ;;
  setup:db:status)
    if needs_upgrade; then
      echo "Run 'setup:upgrade' to update your DB schema and data."
      exit 2
    fi
    echo "All modules are up to date."
    ;;
  */magento-config-warnings.php)
    cat /tmp/magento-fake-config-warnings 2>/dev/null || echo '{"warnings": [], "destructive": []}'
    ;;
  app:config:status)
    if needs_upgrade || [ -e /tmp/magento-fake-config-change ]; then
      echo "Config files have changed. Run app:config:import or setup:upgrade command to synchronize configuration."
      exit 2
    fi
    echo "Config files are up to date."
    ;;
  *) echo "ok: $*" ;;
esac
exit 0
