venv/
**/__pycache__
local.d/

# Left behind by ruff, if you lint the python in bin/ and tests/.
.ruff_cache/

# The vault password, if you encrypt group_vars/all/notifications.yml.
.vault-pass

# Generated by bin/docker-suite up. group_vars/all.yml beside it is not.
inventory/docker/hosts
inventory/docker/known_hosts

# Your own environments. An inventory has to live under inventory/ for Ansible
# to find it, so local.d/ cannot hold one.
inventory/local-*/

# A global excludes file commonly carries a bare `docker` rule, which is
# unanchored and would silently drop this whole directory from every commit. Git
# will not re-include a file whose parent is excluded, hence two rules.
!docker/
!docker/**

# Regenerated by `make docker-up`.
docker/keys/
docker/fixtures/magento-repo.git/
docker/fixtures/.repo-build/

# Nothing here may be named *.docker, for the same reason as above. That is why
# the make include is docker.mk. bin/check-structure fails on any file git
# ignores that is not in its expected list.

*.retry
*.log
*.old
