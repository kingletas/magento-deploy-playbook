#!/bin/bash
#
# Local end-to-end suite: run this playbook against a fake fleet of containers
# instead of real servers.
#
#   bin/docker-suite up        build the image and start the six containers
#   bin/docker-suite deploy    run the full playbook against them
#   bin/docker-suite verify    assert on what the deploy actually produced
#   bin/docker-suite audit     check the audit chain and write an evidence bundle
#   bin/docker-suite test      up + deploy + verify (what `make docker-test` runs)
#   bin/docker-suite test-lost-host  lose web3 mid-upload and mid-switch; the deploy must fail and say so
#   bin/docker-suite test-admin-lost lose the admin host before and during setup:upgrade, and grade each criterion
#   bin/docker-suite test-magento-host  no host can read the database, then a fallback can
#   bin/docker-suite test-after-switch  a step after the switch fails on one host
#   bin/docker-suite test-handler-fails the indexer-reset handler fails at the end; the deploy must not record success
#   bin/docker-suite logs      show the fake tools' call log per container
#   bin/docker-suite reset     clear locks and releases, to repeat a run
#   bin/docker-suite shell <name>
#   bin/docker-suite down      stop and remove everything
#
# The ORCHESTRATION is real -- SSH, the builder-to-web rsync push, the symlink
# flip, the prune -- while Magento, composer and the bundler are fakes that log
# their arguments. docker/README.md has the full table.
#
# `docker` is an ordinary environment of this playbook. Only its `hosts` file is
# special: container IPs are not knowable until the containers run, so it is
# generated.

set -uo pipefail

# Self-locating, and must not reference anything above the repository root.
# bin/check-structure fails on a parent path.
PLAYBOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DOCKER_DIR="${PLAYBOOK_DIR}/docker"
INVENTORY_DIR="${PLAYBOOK_DIR}/inventory/docker"
INVENTORY="${INVENTORY_DIR}/hosts"
CONTAINERS=(mdp-builder mdp-web1 mdp-web2 mdp-web3 mdp-admin mdp-cron mdp-varnish)
APP_CONTAINERS=(mdp-web1 mdp-web2 mdp-web3)

# Who approves the fixture release, and who deploys it. They must differ: the
# playbook refuses a release approved by the person deploying it. The deployer is
# handed to git through the environment rather than the operator's own config.
APPROVER="approver@example.invalid"
DEPLOYER="deployer@example.invalid"
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=user.email GIT_CONFIG_VALUE_0="${DEPLOYER}"

# The audit log this environment writes, from inventory/docker/group_vars/all.yml.
AUDIT_LOG_PATH="${PLAYBOOK_DIR}/local.d/audit/docker.audit.jsonl"

die() { echo "ERROR: $*" >&2; exit 1; }

# The pinned Ansible from `make venv`, when it is there, as the Makefile uses it.
# Behaviour differs between versions: a system Ansible can pass a scenario that
# fails on the version CI and requirements.txt pin.
[ -x "${PLAYBOOK_DIR}/venv/bin/ansible-playbook" ] && export PATH="${PLAYBOOK_DIR}/venv/bin:${PATH}"

cmd_up() {
    command -v docker >/dev/null || die "docker is not installed."
    docker ps >/dev/null 2>&1 || die "the docker daemon is not reachable."

    # Throwaway keypair, generated once and gitignored. The image bakes the
    # public key in as authorized_keys and the private key in for the
    # builder-to-web rsync, so it must exist before the build.
    if [ ! -f "${DOCKER_DIR}/keys/id_test" ]; then
        mkdir -p "${DOCKER_DIR}/keys"
        ssh-keygen -q -t rsa -b 2048 -N '' -C suite@local -f "${DOCKER_DIR}/keys/id_test" \
            || die "could not generate the suite keypair."
        echo "Generated a throwaway keypair in docker/keys/."
    fi

    # An approver's signing key and the allowed_signers file the deploy checks
    # the fixture's approval tag against. Throwaway, generated once, gitignored.
    if [ ! -f "${DOCKER_DIR}/keys/approver" ]; then
        ssh-keygen -q -t ed25519 -N '' -C approver -f "${DOCKER_DIR}/keys/approver" < /dev/null \
            || die "could not generate the approver key."
        printf '%s namespaces="git" %s\n' "${APPROVER}" "$(cat "${DOCKER_DIR}/keys/approver.pub")" \
            > "${DOCKER_DIR}/keys/allowed_signers"
        echo "Generated a throwaway approver key in docker/keys/."
    fi

    # The builder clones this by path, so it has to exist before `up`. Rebuilt
    # when it predates the approval tag, which a deploy now refuses to build without.
    if [ ! -d "${DOCKER_DIR}/fixtures/magento-repo.git" ] \
       || ! git --git-dir="${DOCKER_DIR}/fixtures/magento-repo.git" tag -l 'approved/*' | grep -q .; then
        "${DOCKER_DIR}/fixtures/build-repo.sh" develop || die "could not build the fixture repo."
    fi

    ( cd "${DOCKER_DIR}" && docker compose build && docker compose up -d ) \
        || die "compose failed."

    echo "Waiting for sshd on all six containers..."
    for c in "${CONTAINERS[@]}"; do
        for _ in $(seq 1 30); do
            docker exec "${c}" pgrep -x sshd >/dev/null 2>&1 && break
            sleep 1
        done
        docker exec "${c}" pgrep -x sshd >/dev/null 2>&1 \
            || die "${c} never started sshd."
        printf '  up    %s\n' "${c}"
    done

    cmd_inventory
}

# The hosts file is GENERATED, with container IPs rather than container names.
#
# Names only resolve inside the compose network, and published ports do not
# work either: `synchronize` in tasks/deploy/upload.yml delegates to the builder
# and pushes to the target's ansible_host, so a host-side 127.0.0.1:220X address
# would point the builder at itself. Container IPs are the one address that is
# correct from BOTH the control node and the builder, which is what makes the
# real rsync path testable.
#
# Only `hosts` is generated. inventory/docker/group_vars/all.yml is tracked and
# hand-maintained -- the settings do not depend on which IPs docker handed out.
cmd_inventory() {
    local out="${INVENTORY}" ip
    mkdir -p "${INVENTORY_DIR}"
    {
        echo "# GENERATED by bin/docker-suite up -- do not edit, it is overwritten."
        echo "# Container IPs, not names: see the note in bin/docker-suite."
        echo "# The settings for this environment are in group_vars/all.yml, which"
        echo "# is NOT generated."
        echo ""
        for grp in builder:builder apps:web1,web2,web3 admin:admin cron:cron varnish:varnish; do
            echo "[${grp%%:*}]"
            IFS=',' read -ra members <<< "${grp#*:}"
            for m in "${members[@]}"; do
                ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
                        "mdp-${m}" 2>/dev/null)
                [ -n "${ip}" ] || die "could not read an IP for mdp-${m}."
                echo "${m} ansible_host=${ip}"
            done
            echo ""
        done
        cat <<EOF
[web:children]
apps
admin
cron

[all:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
# ABSOLUTE on purpose. Ansible is invoked from the playbook directory (that is
# where its ansible.cfg is), so a path relative to the inventory file would
# resolve against the wrong directory and fail with "no such identity". The
# suite found this the first time it ran.
ansible_ssh_private_key_file=${DOCKER_DIR}/keys/id_test
# IdentitiesOnly=yes is required, not cosmetic: without it ssh offers every key
# in the operator's agent before the suite's own, and six containers with the
# default MaxAuthTries reject the connection with "Too many authentication
# failures" before the right key is ever tried.
ansible_ssh_common_args=-o StrictHostKeyChecking=yes -o UserKnownHostsFile=${INVENTORY_DIR}/known_hosts -o IdentitiesOnly=yes -o IdentityAgent=none
EOF
    } > "${out}"
    echo "Wrote ${out#"${PLAYBOOK_DIR}/"} from the running containers."
    cmd_known_hosts
}

# Host keys are checked everywhere, so the suite trusts the containers it just
# started: scan them once into known_hosts for the control node, and install the
# same file on the builder for its rsync to the web hosts.
cmd_known_hosts() {
    local known="${INVENTORY_DIR}/known_hosts" ips=() ip
    for c in "${CONTAINERS[@]}"; do
        ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${c}")
        ips+=("${ip}")
    done
    ssh-keyscan -T 10 -t ed25519,ecdsa,rsa "${ips[@]}" > "${known}" 2>/dev/null \
        || die "could not scan the containers' host keys."
    [ -s "${known}" ] || die "ssh-keyscan returned no host keys."
    if ! docker cp "${known}" mdp-builder:/home/ubuntu/.ssh/known_hosts \
       || ! docker exec mdp-builder sh -c 'chown ubuntu:ubuntu /home/ubuntu/.ssh/known_hosts && chmod 600 /home/ubuntu/.ssh/known_hosts'; then
        die "could not install known_hosts on the builder."
    fi
    echo "Scanned ${#ips[@]} host keys into ${known#"${PLAYBOOK_DIR}/"} and onto the builder."
}

# Runs the playbook exactly the way a real deploy runs it: from the playbook
# directory, against inventory/<env>, with no shell profile and no --extra-var.
# There is nothing left to source -- which is the point of the migration, and
# is why this function is now three lines instead of a wrapper chain.
cmd_deploy() {
    [ -f "${INVENTORY}" ] || die "inventory/docker/hosts is missing. Run: bin/docker-suite up"
    ( cd "${PLAYBOOK_DIR}" && ansible-playbook -i inventory/docker deployment.yml "$@" )
}

cmd_verify() {
    [ -f "${INVENTORY}" ] || die "inventory/docker/hosts is missing. Run: bin/docker-suite up"
    ( cd "${PLAYBOOK_DIR}" && ansible-playbook -i inventory/docker verify-deploy.yml "$@" )
}

cmd_logs() {
    for c in "${CONTAINERS[@]}"; do
        echo "=== ${c} ==="
        docker exec "${c}" sh -c 'cat /tmp/build-log 2>/dev/null || echo "  (no fake-tool calls)"' \
            | sed 's/^/  /'
    done
}

cmd_shell() { docker exec -it "mdp-${1:?usage: shell <builder|web1|web2|web3|admin|cron|varnish>}" bash; }

# Clear the build lock and the release tree so a run can be repeated without
# recreating the containers. Deliberately NOT part of `deploy`: a leftover lock
# refusing a second build is correct behaviour, and hiding it would defeat the
# point of testing the lock.
cmd_reset() {
    for c in "${CONTAINERS[@]}"; do
        docker exec "${c}" sh -c '
            rm -f /tmp/*.lock /tmp/magento-fake-needs-upgrade /tmp/magento-fake-patch-id /tmp/magento-fake-break-build /tmp/magento-fake-not-null /tmp/magento-fake-forecast-copy /tmp/magento-fake-break-static
            rm -rf /var/www/html/releases/* /var/www/html/archives/*
            rm -f /var/www/html/magento_current
        ' 2>/dev/null
    done
    truncate_logs
    echo "Cleared locks, releases, archives and the fake-tool log on all six."
}

# TRUNCATE, do not remove. The fakes append as several different users across a
# deploy (ubuntu on the builder, www-data on the web hosts) and their logging is
# deliberately failure-proof, so if the file is recreated 0644 by whoever writes
# first, everyone else loses their entries SILENTLY. Truncating keeps the 0666
# the image created it with.
truncate_logs() {
    for c in "${CONTAINERS[@]}"; do
        docker exec "${c}" sh -c '
            : > /tmp/build-log 2>/dev/null || true
            chmod 666 /tmp/build-log 2>/dev/null || true
        ' 2>/dev/null
    done
}

# `touch` or `rm -f` the file magento-fake reads to report work to do.
set_needs_upgrade() {
    for c in "${CONTAINERS[@]}"; do
        docker exec "${c}" sh -c "$1 /tmp/magento-fake-needs-upgrade" 2>/dev/null
    done
}

cmd_down() { ( cd "${DOCKER_DIR}" && docker compose down -v --remove-orphans ); }

cmd_rollback() {
    [ -f "${PLAYBOOK_DIR}/inventory/docker/hosts" ] || die "no inventory yet: run 'bin/docker-suite up' first."
    ( cd "${PLAYBOOK_DIR}" && ansible-playbook -i inventory/docker rollback.yml "$@" )
}

# Which release `current` points at, and what an app host serves. live_release
# refuses to answer when the app hosts disagree, which is itself a failure.
release_on() { docker exec "$1" sh -c 'basename "$(readlink /var/www/html/magento_current)"'; }
live_release() {
    local first host this
    first="$(release_on "${APP_CONTAINERS[0]}")"
    for host in "${APP_CONTAINERS[@]}"; do
        this="$(release_on "${host}")"
        [ "${this}" = "${first}" ] || die "the app hosts serve different releases: ${APP_CONTAINERS[0]} ${first}, ${host} ${this}."
    done
    echo "${first}"
}
storefront_status() {
    docker exec "${1:-mdp-web1}" python3 -c '
import urllib.request, urllib.error
try:
    print(urllib.request.urlopen("http://127.0.0.1/", timeout=5).status)
except urllib.error.HTTPError as e:
    print(e.code)'
}
has_event_since() {  # has_event_since <line count before> <event>
    tail -n +"$(( $1 + 1 ))" "${AUDIT_LOG_PATH}" | grep -q "\"event\": \"$2\""
}

# The build lock, and what it says. A deploy that stops before anything goes
# live releases it; one that stops where a person must look keeps it with why.
lock_text() { docker exec mdp-builder sh -c 'cat /tmp/*.lock 2>/dev/null'; }
lock_released() {  # lock_released <what stopped>
    docker exec mdp-builder sh -c 'ls /tmp/*.lock 2>/dev/null' >/dev/null && die "$1 left the build lock behind: $(lock_text)"
    return 0
}
lock_held_for() {  # lock_held_for <text the lock must contain> <what stopped>
    lock_text | grep -q "$1" || die "$2 did not keep the build lock with its reason; it says: $(lock_text)"
}

# Every build here is of the same commit, so from the second on both phases are
# reused. A scenario whose fake misbehaves at static deploy has to rebuild it.
REBUILD_STATIC=(-e '{"build_skip": {"compile": true, "static": false, "max_age_days": 7}}')

# setup:static-content:deploy's silent failure: with parallel jobs a theme can
# stop part way with an error in the output and the command still exits 0.
cmd_test_static_verify() {
    local before lines
    echo "########## a static deploy that failed but exited 0: the build must stop ##########"
    before="$(live_release)"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    docker exec mdp-builder touch /tmp/magento-fake-break-static
    cmd_deploy "${REBUILD_STATIC[@]}" && die "a build whose static content was incomplete went ahead."
    docker exec mdp-builder rm -f /tmp/magento-fake-break-static
    [ "$(live_release)" = "${before}" ] || die "the incomplete build went live anyway."
    has_event_since "${lines}" build.succeeded && die "an incomplete build was recorded as build.succeeded."
    tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | grep '"event": "deploy.failed"' | grep -q '"phase": "build"' \
        || die "the stopped build left no deploy.failed record at build."
    lock_released "the stopped build"
    echo "Static content: an incomplete theme behind an exit 0 stopped the build before anything left the builder."
}

# The lock rehearsal, with the real one swapped for a fake: the builder has no
# MariaDB to rehearse on. A release whose setup:upgrade would copy a
# five-million-row table must stop before anything goes live.
cmd_test_forecast() {
    local before lines
    echo "########## a release that would block writes on a large table: it must stop before the cutover ##########"
    before="$(live_release)"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    docker exec mdp-builder touch /tmp/magento-fake-forecast-copy
    set_needs_upgrade touch
    cmd_deploy \
        -e '{"lock_forecast": {"enabled": true, "image": "mariadb:11.4", "stop_on_rows": 1000000, "required": true, "extra_tables": []}}' \
        -e lock_rehearsal_command=/usr/local/bin/lock-rehearsal-fake \
        && die "a release whose rehearsal found a blocking copy went ahead."
    docker exec mdp-builder rm -f /tmp/magento-fake-forecast-copy
    set_needs_upgrade "rm -f"
    [ "$(live_release)" = "${before}" ] || die "the stopped release went live anyway."
    for host in "${APP_CONTAINERS[@]}"; do
        [ "$(storefront_status "${host}")" = 200 ] || die "${host} stopped answering 200 after a deploy that went nowhere."
    done
    has_event_since "${lines}" forecast.completed || die "the rehearsal left no forecast.completed record."
    has_event_since "${lines}" cutover.started && die "the deploy started a cutover after its rehearsal said stop."
    docker exec mdp-admin sh -c 'ls -d /tmp/lock-forecast-* 2>/dev/null' && die "the snapshot was left on the admin host."
    docker exec mdp-builder sh -c 'ls -d /tmp/lock-forecast-* 2>/dev/null' && die "the snapshot was left on the builder."
    tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | grep '"event": "deploy.failed"' | grep -q '"phase": "before-switch"' \
        || die "the stopped deploy left no deploy.failed record before the switch."
    lock_released "the deploy the rehearsal stopped"
    echo "Forecast: a blocking copy over the limit stopped the deploy before the cutover, and the snapshot was deleted."
}

# `touch` or `rm -f` a marker file on every container.
set_marker() {
    for c in "${CONTAINERS[@]}"; do
        docker exec "${c}" sh -c "$1 /tmp/$2" 2>/dev/null
    done
}

# What setup:upgrade's config import will ask, read before the cutover.
cmd_test_config_import() {
    local lines
    echo "########## a release that changes config.php's themes: setup:upgrade must not stop to ask ##########"
    ( cd "${PLAYBOOK_DIR}" && ansible-playbook -i inventory/docker unlock.yml >/dev/null ) || die "could not drop the lock."
    cmd_deploy || die "the recovery deploy after the refused rollback failed."
    set_marker touch magento-fake-config-change
    docker exec mdp-admin sh -c 'cd /var/www/html/magento_current && php bin/magento setup:upgrade --keep-generated' >/dev/null \
        && die "the fake setup:upgrade answered its own prompt, so this scenario proves nothing."
    docker exec mdp-admin sh -c 'echo "{\"warnings\": [{\"section\": \"themes\", \"message\": \"The following themes will be registered: frontend/Acme/shop\"}], \"destructive\": []}" > /tmp/magento-fake-config-warnings'
    truncate_logs
    cmd_deploy || die "a release whose config import only registers a theme failed."
    docker exec mdp-admin grep -q -- 'setup:upgrade --keep-generated --no-interaction' /tmp/build-log \
        || die "setup:upgrade ran without --no-interaction."

    echo ""
    echo "########## a release whose config import deletes a store: it must stop before the cutover ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    docker exec mdp-admin sh -c 'echo "{\"warnings\": [{\"section\": \"scopes\", \"message\": \"These Stores will be deleted: Second\"}], \"destructive\": [{\"section\": \"scopes\", \"message\": \"These Stores will be deleted: Second\"}]}" > /tmp/magento-fake-config-warnings'
    cmd_deploy && die "a release that deletes a store went ahead unaccepted."
    has_event_since "${lines}" cutover.started && die "the deploy started a cutover before the deletion was accepted."
    lock_released "the deploy the config import stopped"
    cmd_deploy -e '{"config_import_accept": "These Stores will be deleted: Second"}' \
        || die "the deploy failed with the deletion accepted by name."
    set_marker "rm -f" magento-fake-config-change
    set_marker "rm -f" magento-fake-config-warnings
    echo "Config import: a theme change deployed with --no-interaction, a store deletion stopped before the cutover until accepted by name."
}

# setup:upgrade failing after the flip: the lock must be released, maintenance
# left on, and the failure recorded. Last, because it leaves the site down.
# A web host lost part way through a deploy. The deploy must stop as a whole,
# name the host and the phase in a deploy.failed record, and record no success,
# however far the other hosts got. The host is brought back and the fleet made
# whole again before the next scenario.
lost_host_restore() {
    docker start mdp-web3 >/dev/null
    cmd_inventory >/dev/null
    docker exec mdp-web3 /etc/init.d/nginx start >/dev/null
    docker exec mdp-builder sh -c 'rm -f /tmp/mdp-hold-upload /tmp/mdp-holding'
    ( cd "${PLAYBOOK_DIR}" && ansible-playbook -i inventory/docker unlock.yml >/dev/null ) || die "could not drop the lock the lost host left held."
}
lost_host_assert() {  # lost_host_assert <lines before> <phase>
    has_event_since "$1" deploy.failed || die "a deploy that lost web3 at $2 left no deploy.failed record."
    tail -n +"$(( $1 + 1 ))" "${AUDIT_LOG_PATH}" | grep '"event": "deploy.failed"' | grep -q "\"phase\": \"$2\"" \
        || die "the deploy.failed record does not say it happened at $2."
    tail -n +"$(( $1 + 1 ))" "${AUDIT_LOG_PATH}" | grep '"event": "deploy.failed"' | grep -q web3 \
        || die "the deploy.failed record does not name web3."
    for event in cutover.succeeded deploy.finished; do
        has_event_since "$1" "${event}" && die "a deploy that lost web3 at $2 still recorded ${event}."
    done
    return 0
}
cmd_test_lost_host() {
    local lines ip
    echo "########## a web host lost mid-upload: the deploy fails, names it, records no success ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    ip="$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' mdp-web3)"
    docker exec mdp-builder sh -c "echo ${ip} > /tmp/mdp-hold-upload"
    cmd_deploy > "${PLAYBOOK_DIR}/local.d/lost-upload.log" 2>&1 &
    local pid=$!
    for _ in $(seq 1 600); do docker exec mdp-builder test -e /tmp/mdp-holding && break; sleep 0.2; done
    docker exec mdp-builder test -e /tmp/mdp-holding || die "the upload to web3 was never held."
    docker stop -t 1 mdp-web3 >/dev/null
    docker exec mdp-builder rm -f /tmp/mdp-hold-upload
    wait "${pid}" && die "a deploy that lost web3 mid-upload reported success."
    lost_host_assert "${lines}" upload
    lock_released "a deploy that lost web3 before anything went live"
    lost_host_restore
    echo "Lost mid-upload: the deploy failed, deploy.failed names web3 at upload, no success recorded."
    echo ""
    echo "########## a web host lost mid-switch: the same, after the other hosts flipped ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    docker exec mdp-web3 touch /tmp/mdp-die-on-reload
    cmd_deploy > "${PLAYBOOK_DIR}/local.d/lost-switch.log" 2>&1 && die "a deploy that lost web3 mid-switch reported success."
    lost_host_assert "${lines}" switch
    lock_held_for "lost web3 at switch" "a deploy that lost web3 mid-switch"
    cmd_deploy > "${PLAYBOOK_DIR}/local.d/lost-switch-refused.log" 2>&1 && die "a deploy ran while the lock held a split fleet's reason."
    grep -q "lost web3 at switch" "${PLAYBOOK_DIR}/local.d/lost-switch-refused.log" \
        || die "the refused deploy did not say why the lock was held."
    lost_host_restore
    echo "Lost mid-switch: the deploy failed, deploy.failed names web3 at switch, no success recorded."
    echo ""
    echo "########## the fleet whole again: a deploy with no fault passes ##########"
    cmd_deploy > "${PLAYBOOK_DIR}/local.d/lost-after.log" 2>&1 || die "a deploy after web3 came back failed."
    live_release >/dev/null
    echo "After both: a clean deploy passes and every app host serves one release."
}

cmd_test_upgrade_fails() {
    local lines
    echo "########## setup:upgrade fails after the flip: maintenance stays, the lock goes ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    set_needs_upgrade touch
    set_marker touch magento-fake-upgrade-fails
    cmd_deploy && die "a deploy whose setup:upgrade failed reported success."
    set_marker "rm -f" magento-fake-upgrade-fails
    set_needs_upgrade "rm -f"
    has_event_since "${lines}" upgrade.failed || die "the failed setup:upgrade left no upgrade.failed record."
    docker exec mdp-builder sh -c 'ls /tmp/*.lock 2>/dev/null' && die "the failed setup:upgrade left the build lock behind."
    for host in "${APP_CONTAINERS[@]}"; do
        [ "$(storefront_status "${host}")" = 503 ] || die "${host} is not in maintenance after setup:upgrade failed."
    done
    echo "Upgrade failure: maintenance kept on both app hosts, the lock released, upgrade.failed recorded."
}

# The admin host is where setup:upgrade runs. Lose it at the step before
# (cache:flush, outside the rescue) and during setup:upgrade (inside it), and
# check each criterion rather than stopping at the first, so one run shows all.
cmd_test_admin_lost() {
    local step tag lines rc ok failures=0 host
    verdict() { if [ "$1" = 0 ]; then echo "  PASS $2"; else echo "  FAIL $2"; failures=$((failures + 1)); fi; }
    for step in cache:flush setup:upgrade; do
        tag="${step//:/-}"
        echo "########## the admin host lost during ${step}: the deploy fails, says so, stays in maintenance ##########"
        lines="$(wc -l < "${AUDIT_LOG_PATH}")"
        set_needs_upgrade touch
        docker exec mdp-admin sh -c "echo ${step} > /tmp/mdp-hold-magento"
        cmd_deploy > "${PLAYBOOK_DIR}/local.d/admin-lost-${tag}.log" 2>&1 &
        local pid=$!
        for _ in $(seq 1 600); do docker exec mdp-admin test -e /tmp/mdp-magento-holding 2>/dev/null && break; sleep 0.2; done
        docker exec mdp-admin test -e /tmp/mdp-magento-holding || die "${step} on the admin host was never held."
        docker stop -t 1 mdp-admin >/dev/null
        wait "${pid}"; rc=$?
        echo "  exit ${rc}; audit events since: $(tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | grep -o '"event": "[a-z.]*"' | cut -d'"' -f4 | paste -sd' ')"
        verdict "$(( rc == 0 ))" "the deploy exits non-zero"
        tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | grep -E '"event": "(deploy|upgrade)\.failed"' | grep -q admin
        verdict $? "a failure record names the admin host"
        ! has_event_since "${lines}" cutover.succeeded && ! has_event_since "${lines}" deploy.finished
        verdict $? "no cutover.succeeded or deploy.finished is recorded"
        for host in "${APP_CONTAINERS[@]}"; do
            ok=1; [ "$(storefront_status "${host}")" = 503 ] && ok=0
            verdict "${ok}" "${host} is in maintenance"
        done
        ! grep -E 'lost (mdp-)?web[0-9]' "${PLAYBOOK_DIR}/local.d/admin-lost-${tag}.log" >/dev/null
        verdict $? "no healthy app host is named lost"
        grep -E '"msg": .*(maint:disable|make unlock)' "${PLAYBOOK_DIR}/local.d/admin-lost-${tag}.log" >/dev/null
        verdict $? "the output says how to recover"
        sed -n '/PLAY RECAP/,$p' "${PLAYBOOK_DIR}/local.d/admin-lost-${tag}.log" | grep -E '^(mdp-|web|admin|cron|builder|varnish|localhost)' | sed 's/^/  recap: /'

        docker start mdp-admin >/dev/null
        cmd_inventory >/dev/null
        docker exec mdp-admin sh -c 'rm -f /tmp/mdp-hold-magento /tmp/mdp-magento-holding; /etc/init.d/nginx start' >/dev/null
        set_needs_upgrade "rm -f"
        ( cd "${PLAYBOOK_DIR}" && ansible-playbook -i inventory/docker unlock.yml >/dev/null ) || die "could not drop the lock the lost admin host left held."
        cmd_deploy > "${PLAYBOOK_DIR}/local.d/admin-lost-${tag}-after.log" 2>&1
        verdict $? "with the admin host back, a clean deploy passes"
        echo ""
    done
    [ "${failures}" = 0 ] || die "${failures} criteria failed with the admin host lost."
    echo "Admin host lost: every criterion held at both steps."
}

# The host that runs Magento's commands is chosen before anything goes live:
# with none able to read the database the deploy stops there, and with a
# fallback named it uses the fallback.
cmd_test_magento_host() {
    local lines before log
    echo "########## no host can read the database: the deploy stops before anything goes live ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    before="$(live_release)"
    docker exec mdp-admin touch /tmp/magento-fake-no-database
    log="${PLAYBOOK_DIR}/local.d/magento-host-none.log"
    cmd_deploy > "${log}" 2>&1 && die "a deploy no host could run Magento's commands for reported success."
    tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | grep '"event": "deploy.failed"' | grep '"phase": "magento-host"' \
        | grep -q 'admin: exit 1' || die "the stopped deploy left no deploy.failed record with what admin answered."
    has_event_since "${lines}" cutover.started && die "a deploy no host could run Magento's commands for still began the cutover."
    [ "$(live_release)" = "${before}" ] || die "the live release changed, although nothing should have gone live."
    for host in "${APP_CONTAINERS[@]}"; do
        [ "$(storefront_status "${host}")" = 200 ] || die "${host} is not serving after a deploy that stopped before the cutover."
    done
    docker exec mdp-builder sh -c 'ls /tmp/*.lock 2>/dev/null' && die "the stopped deploy left the build lock behind."
    echo "No host: the deploy stopped before the cutover, recorded what admin answered, and released the lock."
    echo ""
    echo "########## the admin host cannot, a fallback can: the deploy uses the fallback ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    log="${PLAYBOOK_DIR}/local.d/magento-host-fallback.log"
    cmd_deploy -e '{"magento_hosts": ["admin", "web1"]}' > "${log}" 2>&1 || die "a deploy with a working fallback host failed."
    docker exec mdp-admin rm -f /tmp/magento-fake-no-database
    grep -q "web1 runs Magento's commands for this deploy, because admin could not read the database" "${log}" \
        || die "the deploy did not say it passed over admin."
    tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | grep '"event": "cutover.started"' | grep -q '"magento_host": "web1"' \
        || die "cutover.started does not name web1 as the host that ran Magento's commands."
    live_release >/dev/null
    echo "Fallback: admin passed over, web1 ran Magento's commands, and the deploy passed."
    echo ""
    echo "########## both can, admin listed first: admin is chosen, the fallback stays a fallback ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    cmd_deploy -e '{"magento_hosts": ["admin", "web1"]}' > "${PLAYBOOK_DIR}/local.d/magento-host-preferred.log" 2>&1 \
        || die "a deploy with both hosts able to answer failed."
    tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | grep '"event": "cutover.started"' | grep -q '"magento_host": "admin"' \
        || die "admin, listed first and able to answer, was not the host chosen."
    echo "Preference: admin, listed first, ran Magento's commands with web1 as the unused fallback."
}

# A step after the switch fails on one host: the deploy stops for every host,
# records the step, releases the lock and says what is left to run by hand.
cmd_test_after_switch() {
    local lines log record host
    echo "########## maint:disable fails on web2 after setup:upgrade: the deploy stops and says what is left ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    log="${PLAYBOOK_DIR}/local.d/after-switch.log"
    set_needs_upgrade touch
    docker exec mdp-web2 sh -c 'echo maint:disable > /tmp/magento-fake-fail-on'
    cmd_deploy > "${log}" 2>&1 && die "a deploy whose maint:disable failed on web2 reported success."
    docker exec mdp-web2 rm -f /tmp/magento-fake-fail-on
    set_needs_upgrade "rm -f"
    record="$(tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | grep '"event": "deploy.failed"')"
    grep -q '"phase": "after-switch"' <<< "${record}" || die "the failed step left no deploy.failed record at after-switch."
    grep -q 'web2' <<< "${record}" || die "the deploy.failed record does not name web2."
    for event in cutover.succeeded deploy.finished; do
        has_event_since "${lines}" "${event}" && die "a deploy whose maint:disable failed still recorded ${event}."
    done
    docker exec mdp-builder sh -c 'ls /tmp/*.lock 2>/dev/null' && die "the failed step left the build lock behind."
    [ "$(storefront_status mdp-web2)" = 503 ] || die "web2 is not left in maintenance, although its maint:disable failed."
    for host in mdp-web1 mdp-web3; do
        [ "$(storefront_status "${host}")" = 200 ] || die "${host} is not serving, although its maint:disable ran."
    done
    grep -q 'the rollback guard would refuse a code rollback' "${log}" || die "the message does not say a code rollback is refused after setup:upgrade."
    grep -q 'maint:disable, on every web host' "${log}" || die "the message does not list maint:disable among the steps left."
    docker exec mdp-web2 sh -c 'cd /var/www/html/magento_current && php bin/magento maint:disable' >/dev/null
    [ "$(storefront_status mdp-web2)" = 200 ] || die "web2 does not serve after maint:disable was run by hand, as the message says."
    echo "After the switch: the deploy stopped for every host, named the step and web2, released the lock, and the step left ran by hand."
}

# The handlers run at the end of the Magento play. With kill_php on, a clean
# deploy runs the indexer reset and passes; when that reset fails, the deploy
# stops before it is recorded as finished, releases the lock and says what is left.
cmd_test_handler_fails() {
    local lines log host
    echo "########## kill_php on, nothing fails: the handlers run and the deploy passes ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    truncate_logs
    cmd_deploy -e kill_php=true > "${PLAYBOOK_DIR}/local.d/handlers-clean.log" 2>&1 \
        || die "a clean deploy with kill_php on failed. local.d/handlers-clean.log has the run."
    has_event_since "${lines}" deploy.finished || die "a clean deploy with kill_php on recorded no deploy.finished."
    docker exec mdp-web1 grep -q 'fake-mysql.*mview_state' /tmp/build-log \
        || die "the indexer-reset handler did not run on web1."
    echo "Clean: the handlers ran, the indexers were reset, and the deploy was recorded as finished."
    echo ""
    echo "########## the indexer reset fails: the deploy stops before it is recorded as finished ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    log="${PLAYBOOK_DIR}/local.d/handlers-fail.log"
    for host in "${APP_CONTAINERS[@]}"; do docker exec "${host}" touch /tmp/mysql-fake-fail; done
    cmd_deploy -e kill_php=true > "${log}" 2>&1 && die "a deploy whose indexer reset failed reported success."
    for host in "${APP_CONTAINERS[@]}"; do docker exec "${host}" rm -f /tmp/mysql-fake-fail; done
    has_event_since "${lines}" deploy.finished && die "a deploy whose indexer reset failed still recorded deploy.finished."
    tail -n +"$(( lines + 1 ))" "${AUDIT_LOG_PATH}" | tail -n 1 | grep '"event": "deploy.failed"' | grep -q 'Reset the indexers' \
        || die "the run's last record is not a deploy.failed naming the indexer reset."
    docker exec mdp-builder sh -c 'ls /tmp/*.lock 2>/dev/null' && die "the failed handler left the build lock behind."
    for host in "${APP_CONTAINERS[@]}"; do
        [ "$(storefront_status "${host}")" = 200 ] || die "${host} is not serving, although every step before the handlers ran."
    done
    grep -q 'mysql -e "use magento;.*mview_state' "${log}" || die "the message does not list the indexer reset among the steps left."
    echo "Handler fails: no deploy.finished, the last record names the indexer reset, the lock is released, and the site still serves."
}

# The guarded rollback, both ways and from both entry points. Runs after the
# audit check, because a rolled-back deploy rightly lacks cutover.succeeded.
cmd_test_rollback() {
    local before live lines
    echo "########## roll back by hand, over a patch and a key the target never saw ##########"
    before="$(live_release)"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    docker exec mdp-admin sh -c 'echo "UNIQUE cms_block(identifier)" > /tmp/magento-fake-new-constraint'
    cmd_rollback && die "the rollback went ahead over a data patch and a key nobody accepted."
    [ "$(live_release)" = "${before}" ] || die "a refused rollback still moved current."
    has_event_since "${lines}" rollback.refused || die "the refused rollback left no rollback.refused record."
    cmd_rollback -e 'rollback_accept_patches=Fake\Patch\Data\P1' \
        && die "the rollback went ahead with the patch accepted but not the key."
    cmd_rollback -e 'rollback_accept_patches=Fake\Patch\Data\P1' -e '{"rollback_accept_constraints": "UNIQUE cms_block(identifier)"}' \
        || die "the rollback failed with the listed patch and key accepted."
    docker exec mdp-admin rm -f /tmp/magento-fake-new-constraint
    [ "$(live_release)" != "${before}" ] || die "the accepted rollback did not move current."
    for host in "${APP_CONTAINERS[@]}"; do
        [ "$(storefront_status "${host}")" = 200 ] || die "the release rolled back to does not answer 200 on ${host}."
    done

    echo ""
    echo "########## deploy a broken release: it must roll itself back ##########"
    before="$(live_release)"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    docker exec mdp-builder touch /tmp/magento-fake-break-build
    cmd_deploy "${REBUILD_STATIC[@]}" && die "a deploy whose release failed its health check reported success."
    docker exec mdp-builder rm -f /tmp/magento-fake-break-build
    [ "$(live_release)" = "${before}" ] || die "the broken release was not rolled back: $(live_release) is live."
    for host in "${APP_CONTAINERS[@]}"; do
        [ "$(storefront_status "${host}")" = 200 ] || die "the rolled-back site does not answer 200 on ${host}."
    done
    has_event_since "${lines}" deploy.rolled_back || die "the automatic rollback left no deploy.rolled_back record."
    docker exec mdp-builder sh -c 'ls /tmp/*.lock 2>/dev/null' && die "the rolled-back deploy left the build lock behind."

    echo ""
    echo "########## deploy a broken release that moved the database: it must NOT roll back ##########"
    lines="$(wc -l < "${AUDIT_LOG_PATH}")"
    docker exec mdp-builder touch /tmp/magento-fake-break-build
    set_needs_upgrade touch
    cmd_deploy "${REBUILD_STATIC[@]}" && die "a deploy whose release failed its health check reported success."
    docker exec mdp-builder rm -f /tmp/magento-fake-break-build
    set_needs_upgrade "rm -f"
    live="$(live_release)"
    [ "${live}" != "${before}" ] || die "the rollback went ahead although the database had moved."
    for host in "${APP_CONTAINERS[@]}"; do
        [ "$(storefront_status "${host}")" = 503 ] || die "the release that could not go back is not in maintenance on ${host}."
    done
    has_event_since "${lines}" rollback.refused || die "the refused rollback left no rollback.refused record."
    lock_held_for "could not go back, so the site is in maintenance" "the deploy whose rollback was refused"
    "${PLAYBOOK_DIR}/bin/audit-log" verify --path "${AUDIT_LOG_PATH}" || die "the audit chain broke during the rollback runs."
    echo "Rollback: refused over an unlisted patch, accepted with it named, automatic on a broken release, refused and in maintenance when the database moved."
}

# The deploy records what it did; this proves the record is intact and complete.
cmd_audit() {
    "${PLAYBOOK_DIR}/bin/audit-log" verify --path "${AUDIT_LOG_PATH}" || return 1
    local release
    release=$(python3 -c "
import json, sys
records = [json.loads(line) for line in open(sys.argv[1])]
finished = [r for r in records if r.get('event') == 'deploy.finished']
print(finished[-1]['release'] if finished else '')
" "${AUDIT_LOG_PATH}")
    [ -n "${release}" ] || die "no finished deploy in ${AUDIT_LOG_PATH}."
    "${PLAYBOOK_DIR}/bin/audit-log" evidence --path "${AUDIT_LOG_PATH}" --release "${release}" \
        --out "${PLAYBOOK_DIR}/local.d/evidence/docker/${release}" || return 1
    for event in deploy.started approval.verified build.succeeded backup.succeeded \
                 cutover.started maintenance.enabled cutover.succeeded deploy.finished deploy.verified; do
        grep -q "\"event\": \"${event}\"" "${PLAYBOOK_DIR}/local.d/evidence/docker/${release}/audit.jsonl" \
            || die "the evidence for ${release} has no ${event} record."
    done
    echo "Audit chain intact, and ${release}'s evidence carries every event."
}

cmd_test() {
    cmd_up || exit 1
    # `up` on already-running containers is a no-op, so /tmp/build-log and any
    # leftover lock survive from a previous run. verify-deploy.yml counts log
    # entries, so a stale log makes it fail on a deploy that was fine.
    echo ""
    cmd_reset
    echo ""
    echo "########## deploy ##########"
    cmd_deploy || die "the deploy failed. bin/docker-suite logs shows what the fakes were asked to do."
    # A second deploy, so there is a superseded release for verify to check is
    # safe to roll back to. The log is truncated because verify counts one run.
    echo ""
    echo "########## deploy again, over the first release ##########"
    truncate_logs
    cmd_deploy || die "the second deploy failed. bin/docker-suite logs shows what the fakes were asked to do."
    echo ""
    echo "########## verify ##########"
    cmd_verify -e expect_reuse=true || die "the deploy completed but verification failed."
    # A third deploy whose status commands report work to do, so the maintenance
    # window and setup:upgrade are exercised as well as skipped.
    echo ""
    echo "########## deploy a release that needs setup:upgrade ##########"
    truncate_logs
    set_needs_upgrade touch
    cmd_deploy || die "the upgrade deploy failed. bin/docker-suite logs shows what the fakes were asked to do."
    echo ""
    echo "########## verify the upgrade deploy ##########"
    cmd_verify -e expect_upgrade=true -e expect_reuse=true || die "the upgrade deploy completed but verification failed."
    set_needs_upgrade "rm -f"
    echo ""
    echo "########## audit trail ##########"
    cmd_audit || die "the audit trail is incomplete or has been changed." 
    echo ""
    cmd_test_static_verify
    echo ""
    cmd_test_forecast
    echo ""
    cmd_test_rollback
    echo ""
    cmd_test_config_import
    echo ""
    cmd_test_upgrade_fails
    echo ""
    cmd_test_lost_host
    echo ""
    cmd_test_admin_lost
    echo ""
    cmd_test_magento_host
    echo ""
    cmd_test_after_switch
    echo ""
    cmd_test_handler_fails
    echo ""
    echo "All good. Tear down with: bin/docker-suite down"
}

case "${1:-}" in
    up)      shift; cmd_up "$@" ;;
    inventory) shift; cmd_inventory "$@" ;;
    deploy)  shift; cmd_deploy "$@" ;;
    rollback) shift; cmd_rollback "$@" ;;
    verify)  shift; cmd_verify "$@" ;;
    audit)   shift; cmd_audit "$@" ;;
    test)    shift; cmd_test "$@" ;;
    test-lost-host) shift; cmd_test_lost_host "$@" ;;
    test-admin-lost) shift; cmd_test_admin_lost "$@" ;;
    test-magento-host) shift; cmd_test_magento_host "$@" ;;
    test-after-switch) shift; cmd_test_after_switch "$@" ;;
    test-handler-fails) shift; cmd_test_handler_fails "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    shell)   shift; cmd_shell "$@" ;;
    reset)   shift; cmd_reset "$@" ;;
    down)    shift; cmd_down "$@" ;;
    *) sed -n '3,26p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
