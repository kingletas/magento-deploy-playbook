#!/bin/bash
#
# Local end-to-end suite: run this playbook against a fake fleet of containers
# instead of real servers.
#
#   bin/docker-suite up        build the image and start the six containers
#   bin/docker-suite deploy    run the full playbook against them
#   bin/docker-suite verify    assert on what the deploy actually produced
#   bin/docker-suite audit     check the audit chain and write an evidence bundle
#   bin/docker-suite test      up + deploy + verify (what `make docker-test` runs)
#   bin/docker-suite logs      show the fake tools' call log per container
#   bin/docker-suite reset     clear locks and releases, to repeat a run
#   bin/docker-suite shell <name>
#   bin/docker-suite down      stop and remove everything
#
# The ORCHESTRATION is real -- SSH, the builder-to-web rsync push, the symlink
# flip, the prune -- while Magento, composer and the bundler are fakes that log
# their arguments. docker/README.md has the full table.
#
# `docker` is an ordinary environment of this playbook. Only its `hosts` file is
# special: container IPs are not knowable until the containers run, so it is
# generated.

set -uo pipefail

# Self-locating, and must not reference anything above the repository root.
# bin/check-structure fails on a parent path.
PLAYBOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DOCKER_DIR="${PLAYBOOK_DIR}/docker"
INVENTORY_DIR="${PLAYBOOK_DIR}/inventory/docker"
INVENTORY="${INVENTORY_DIR}/hosts"
CONTAINERS=(mdp-builder mdp-web1 mdp-web2 mdp-admin mdp-cron mdp-varnish)

# Who approves the fixture release, and who deploys it. They must differ: the
# playbook refuses a release approved by the person deploying it. The deployer is
# handed to git through the environment rather than the operator's own config.
APPROVER="approver@example.invalid"
DEPLOYER="deployer@example.invalid"
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=user.email GIT_CONFIG_VALUE_0="${DEPLOYER}"

# The audit log this environment writes, from inventory/docker/group_vars/all.yml.
AUDIT_LOG_PATH="${PLAYBOOK_DIR}/local.d/audit/docker.audit.jsonl"

die() { echo "ERROR: $*" >&2; exit 1; }

cmd_up() {
    command -v docker >/dev/null || die "docker is not installed."
    docker ps >/dev/null 2>&1 || die "the docker daemon is not reachable."

    # Throwaway keypair, generated once and gitignored. The image bakes the
    # public key in as authorized_keys and the private key in for the
    # builder-to-web rsync, so it must exist before the build.
    if [ ! -f "${DOCKER_DIR}/keys/id_test" ]; then
        mkdir -p "${DOCKER_DIR}/keys"
        ssh-keygen -q -t rsa -b 2048 -N '' -C suite@local -f "${DOCKER_DIR}/keys/id_test" \
            || die "could not generate the suite keypair."
        echo "Generated a throwaway keypair in docker/keys/."
    fi

    # An approver's signing key and the allowed_signers file the deploy checks
    # the fixture's approval tag against. Throwaway, generated once, gitignored.
    if [ ! -f "${DOCKER_DIR}/keys/approver" ]; then
        ssh-keygen -q -t ed25519 -N '' -C approver -f "${DOCKER_DIR}/keys/approver" < /dev/null \
            || die "could not generate the approver key."
        printf '%s namespaces="git" %s\n' "${APPROVER}" "$(cat "${DOCKER_DIR}/keys/approver.pub")" \
            > "${DOCKER_DIR}/keys/allowed_signers"
        echo "Generated a throwaway approver key in docker/keys/."
    fi

    # The builder clones this by path, so it has to exist before `up`. Rebuilt
    # when it predates the approval tag, which a deploy now refuses to build without.
    if [ ! -d "${DOCKER_DIR}/fixtures/magento-repo.git" ] \
       || ! git --git-dir="${DOCKER_DIR}/fixtures/magento-repo.git" tag -l 'approved/*' | grep -q .; then
        "${DOCKER_DIR}/fixtures/build-repo.sh" develop || die "could not build the fixture repo."
    fi

    ( cd "${DOCKER_DIR}" && docker compose build && docker compose up -d ) \
        || die "compose failed."

    echo "Waiting for sshd on all six containers..."
    for c in "${CONTAINERS[@]}"; do
        for _ in $(seq 1 30); do
            docker exec "${c}" pgrep -x sshd >/dev/null 2>&1 && break
            sleep 1
        done
        docker exec "${c}" pgrep -x sshd >/dev/null 2>&1 \
            || die "${c} never started sshd."
        printf '  up    %s\n' "${c}"
    done

    cmd_inventory
}

# The hosts file is GENERATED, with container IPs rather than container names.
#
# Names only resolve inside the compose network, and published ports do not
# work either: `synchronize` in tasks/deploy/upload.yml delegates to the builder
# and pushes to the target's ansible_host, so a host-side 127.0.0.1:220X address
# would point the builder at itself. Container IPs are the one address that is
# correct from BOTH the control node and the builder, which is what makes the
# real rsync path testable.
#
# Only `hosts` is generated. inventory/docker/group_vars/all.yml is tracked and
# hand-maintained -- the settings do not depend on which IPs docker handed out.
cmd_inventory() {
    local out="${INVENTORY}" ip
    mkdir -p "${INVENTORY_DIR}"
    {
        echo "# GENERATED by bin/docker-suite up -- do not edit, it is overwritten."
        echo "# Container IPs, not names: see the note in bin/docker-suite."
        echo "# The settings for this environment are in group_vars/all.yml, which"
        echo "# is NOT generated."
        echo ""
        for grp in builder:builder apps:web1,web2 admin:admin cron:cron varnish:varnish; do
            echo "[${grp%%:*}]"
            IFS=',' read -ra members <<< "${grp#*:}"
            for m in "${members[@]}"; do
                ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' \
                        "mdp-${m}" 2>/dev/null)
                [ -n "${ip}" ] || die "could not read an IP for mdp-${m}."
                echo "${m} ansible_host=${ip}"
            done
            echo ""
        done
        cat <<EOF
[web:children]
apps
admin
cron

[all:vars]
ansible_user=ubuntu
ansible_python_interpreter=/usr/bin/python3
# ABSOLUTE on purpose. Ansible is invoked from the playbook directory (that is
# where its ansible.cfg is), so a path relative to the inventory file would
# resolve against the wrong directory and fail with "no such identity". The
# suite found this the first time it ran.
ansible_ssh_private_key_file=${DOCKER_DIR}/keys/id_test
# IdentitiesOnly=yes is required, not cosmetic: without it ssh offers every key
# in the operator's agent before the suite's own, and six containers with the
# default MaxAuthTries reject the connection with "Too many authentication
# failures" before the right key is ever tried.
ansible_ssh_common_args=-o StrictHostKeyChecking=yes -o UserKnownHostsFile=${INVENTORY_DIR}/known_hosts -o IdentitiesOnly=yes -o IdentityAgent=none
EOF
    } > "${out}"
    echo "Wrote ${out#"${PLAYBOOK_DIR}/"} from the running containers."
    cmd_known_hosts
}

# Host keys are checked everywhere, so the suite trusts the containers it just
# started: scan them once into known_hosts for the control node, and install the
# same file on the builder for its rsync to the web hosts.
cmd_known_hosts() {
    local known="${INVENTORY_DIR}/known_hosts" ips=() ip
    for c in "${CONTAINERS[@]}"; do
        ip=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "${c}")
        ips+=("${ip}")
    done
    ssh-keyscan -T 10 -t ed25519,ecdsa,rsa "${ips[@]}" > "${known}" 2>/dev/null \
        || die "could not scan the containers' host keys."
    [ -s "${known}" ] || die "ssh-keyscan returned no host keys."
    docker cp "${known}" mdp-builder:/home/ubuntu/.ssh/known_hosts \
        && docker exec mdp-builder sh -c 'chown ubuntu:ubuntu /home/ubuntu/.ssh/known_hosts && chmod 600 /home/ubuntu/.ssh/known_hosts' \
        || die "could not install known_hosts on the builder."
    echo "Scanned ${#ips[@]} host keys into ${known#"${PLAYBOOK_DIR}/"} and onto the builder."
}

# Runs the playbook exactly the way a real deploy runs it: from the playbook
# directory, against inventory/<env>, with no shell profile and no --extra-var.
# There is nothing left to source -- which is the point of the migration, and
# is why this function is now three lines instead of a wrapper chain.
cmd_deploy() {
    [ -f "${INVENTORY}" ] || die "inventory/docker/hosts is missing. Run: bin/docker-suite up"
    ( cd "${PLAYBOOK_DIR}" && ansible-playbook -i inventory/docker deployment.yml "$@" )
}

cmd_verify() {
    [ -f "${INVENTORY}" ] || die "inventory/docker/hosts is missing. Run: bin/docker-suite up"
    ( cd "${PLAYBOOK_DIR}" && ansible-playbook -i inventory/docker verify-deploy.yml "$@" )
}

cmd_logs() {
    for c in "${CONTAINERS[@]}"; do
        echo "=== ${c} ==="
        docker exec "${c}" sh -c 'cat /tmp/build-log 2>/dev/null || echo "  (no fake-tool calls)"' \
            | sed 's/^/  /'
    done
}

cmd_shell() { docker exec -it "mdp-${1:?usage: shell <builder|web1|web2|admin|cron|varnish>}" bash; }

# Clear the build lock and the release tree so a run can be repeated without
# recreating the containers. Deliberately NOT part of `deploy`: a leftover lock
# refusing a second build is correct behaviour, and hiding it would defeat the
# point of testing the lock.
cmd_reset() {
    for c in "${CONTAINERS[@]}"; do
        docker exec "${c}" sh -c '
            rm -f /tmp/*.lock /tmp/magento-fake-needs-upgrade
            rm -rf /var/www/html/releases/* /var/www/html/archives/*
            rm -f /var/www/html/magento_current
        ' 2>/dev/null
    done
    truncate_logs
    echo "Cleared locks, releases, archives and the fake-tool log on all six."
}

# TRUNCATE, do not remove. The fakes append as several different users across a
# deploy (ubuntu on the builder, www-data on the web hosts) and their logging is
# deliberately failure-proof, so if the file is recreated 0644 by whoever writes
# first, everyone else loses their entries SILENTLY. Truncating keeps the 0666
# the image created it with.
truncate_logs() {
    for c in "${CONTAINERS[@]}"; do
        docker exec "${c}" sh -c '
            : > /tmp/build-log 2>/dev/null || true
            chmod 666 /tmp/build-log 2>/dev/null || true
        ' 2>/dev/null
    done
}

# `touch` or `rm -f` the file magento-fake reads to report work to do.
set_needs_upgrade() {
    for c in "${CONTAINERS[@]}"; do
        docker exec "${c}" sh -c "$1 /tmp/magento-fake-needs-upgrade" 2>/dev/null
    done
}

cmd_down() { ( cd "${DOCKER_DIR}" && docker compose down -v --remove-orphans ); }

# The deploy records what it did; this proves the record is intact and complete.
cmd_audit() {
    "${PLAYBOOK_DIR}/bin/audit-log" verify --path "${AUDIT_LOG_PATH}" || return 1
    local release
    release=$(python3 -c "
import json, sys
records = [json.loads(line) for line in open(sys.argv[1])]
finished = [r for r in records if r.get('event') == 'deploy.finished']
print(finished[-1]['release'] if finished else '')
" "${AUDIT_LOG_PATH}")
    [ -n "${release}" ] || die "no finished deploy in ${AUDIT_LOG_PATH}."
    "${PLAYBOOK_DIR}/bin/audit-log" evidence --path "${AUDIT_LOG_PATH}" --release "${release}" \
        --out "${PLAYBOOK_DIR}/local.d/evidence/docker/${release}" || return 1
    for event in deploy.started approval.verified build.succeeded backup.succeeded \
                 cutover.started maintenance.enabled cutover.succeeded deploy.finished deploy.verified; do
        grep -q "\"event\": \"${event}\"" "${PLAYBOOK_DIR}/local.d/evidence/docker/${release}/audit.jsonl" \
            || die "the evidence for ${release} has no ${event} record."
    done
    echo "Audit chain intact, and ${release}'s evidence carries every event."
}

cmd_test() {
    cmd_up || exit 1
    # `up` on already-running containers is a no-op, so /tmp/build-log and any
    # leftover lock survive from a previous run. verify-deploy.yml counts log
    # entries, so a stale log makes it fail on a deploy that was fine.
    echo ""
    cmd_reset
    echo ""
    echo "########## deploy ##########"
    cmd_deploy || die "the deploy failed. bin/docker-suite logs shows what the fakes were asked to do."
    # A second deploy, so there is a superseded release for verify to check is
    # safe to roll back to. The log is truncated because verify counts one run.
    echo ""
    echo "########## deploy again, over the first release ##########"
    truncate_logs
    cmd_deploy || die "the second deploy failed. bin/docker-suite logs shows what the fakes were asked to do."
    echo ""
    echo "########## verify ##########"
    cmd_verify || die "the deploy completed but verification failed."
    # A third deploy whose status commands report work to do, so the maintenance
    # window and setup:upgrade are exercised as well as skipped.
    echo ""
    echo "########## deploy a release that needs setup:upgrade ##########"
    truncate_logs
    set_needs_upgrade touch
    cmd_deploy || die "the upgrade deploy failed. bin/docker-suite logs shows what the fakes were asked to do."
    echo ""
    echo "########## verify the upgrade deploy ##########"
    cmd_verify -e expect_upgrade=true || die "the upgrade deploy completed but verification failed."
    set_needs_upgrade "rm -f"
    echo ""
    echo "########## audit trail ##########"
    cmd_audit || die "the audit trail is incomplete or has been changed." 
    echo ""
    echo "All good. Tear down with: bin/docker-suite down"
}

case "${1:-}" in
    up)      shift; cmd_up "$@" ;;
    inventory) shift; cmd_inventory "$@" ;;
    deploy)  shift; cmd_deploy "$@" ;;
    verify)  shift; cmd_verify "$@" ;;
    audit)   shift; cmd_audit "$@" ;;
    test)    shift; cmd_test "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    shell)   shift; cmd_shell "$@" ;;
    reset)   shift; cmd_reset "$@" ;;
    down)    shift; cmd_down "$@" ;;
    *) sed -n '3,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
