# The lab fleet's settings. Copy to lab.env; every value here is generic.
# Passwords are never set here: bin/with-secrets reads them from the files
# under secrets/ and exports them only for the command it runs.

# The Magento 2.4.8-p2 tree, with its vendor/, that releases are built from,
# and this playbook's checkout, which the arms run from. Absolute paths on
# the Docker host.
ZDT_LAB_SRC=/srv/zdt-lab/magento-src
ZDT_PLAYBOOK=/srv/zdt-lab/magento-deploy-playbook
ZDT_RUN_DIR=/runs

# Database connection
ZDT_DB_HOST=db-primary
ZDT_DB_USER=magento
ZDT_DB_NAME=magento

# Primary database
ZDT_PRIMARY_HOST=db-primary
ZDT_PRIMARY_USER=magento
ZDT_PRIMARY_DATABASE=magento

# Replica database
ZDT_REPLICA_HOST=db-replica
ZDT_REPLICA_USER=magento
ZDT_REPLICA_DATABASE=magento

# Modules in the source tree to install disabled, comma-separated, so the
# store runs stock. Empty when the tree is stock already.
ZDT_DISABLE_MODULES=

# Search and cache, by their compose hostnames
ZDT_SEARCH_HOST=opensearch
ZDT_CACHE_HOST=valkey

# Web hosts
ZDT_WEB_HOSTS=web1,web2,web3
ZDT_NEW_NODE=web1
ZDT_ADMIN_NODE=web1

# URLs
ZDT_LB_URL=http://lb
ZDT_LB_STATS_URL=http://lb:8404/stats;csv
ZDT_NODE_URLS=http://web1,http://web2,http://web3

# Release and environment settings
ZDT_ENV_PHP=/var/www/magento/shared/app/etc/env.php
# Reloads PHP-FPM on a node after env.php changes; shipped in the web image.
ZDT_FPM_RELOAD=zdtfleet-fpm-reload
ZDT_RELEASES_DIR=/var/www/magento/releases
ZDT_CURRENT_LINK=/var/www/magento/current
ZDT_SNAPSHOT_DIR=/var/www/magento/zdt-snapshots

# Release labels
ZDT_LABEL_OLD=r0
ZDT_LABEL_NEW=r1
ZDT_LABEL_ADDITIVE=r2-additive
ZDT_LABEL_BREAKING=r2-breaking

# Releases
ZDT_RELEASE_TARBALL=/releases/r1.tar.gz
ZDT_RELEASE_ADDITIVE=/releases/r2-additive.tar.gz
ZDT_RELEASE_BREAKING=/releases/r2-breaking.tar.gz

# Traffic settings
ZDT_RATE=2
ZDT_DURATION=120

# Schema object for arm3
ZDT_READ_PATH=/zdtprobe/read
ZDT_SCHEMA_OBJECT=probe_value

# Guard pattern
ZDT_GUARD_PATTERN=Please refresh|config was changed|Setup must be run

# Product and category paths
ZDT_CATEGORY_PATH=/category.html
ZDT_PRODUCT_PATH=/product.html

# Touched tables
ZDT_TOUCHED_TABLES=catalog_product_entity
