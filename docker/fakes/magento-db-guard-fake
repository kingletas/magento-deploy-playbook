#!/bin/bash
# Stands in for files/helpers/magento-db-guard.php on the admin host.
#
# The fake Magento's setup:upgrade applies one patch whenever it runs with work
# to do, and /tmp/magento-fake-patch-id counts them, so a mark and a check see
# the same thing the real helper would read from patch_list. Lines in
# /tmp/magento-fake-not-null are reported as undeclared NOT NULL columns.
echo "[fake-db-guard] $1" >> /tmp/build-log 2>/dev/null || true
patch_id="$(cat /tmp/magento-fake-patch-id 2>/dev/null || echo 0)"
case "$1" in
  mark)
    printf '{"patch_id": %s, "recorded_at": "2026-01-01 00:00:00"}\n' "${patch_id}" ;;
  check)
    mark="$(printf '%s' "$3" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("patch_id", 0))')"
    python3 - "${mark}" "${patch_id}" <<'PY'
import json, sys
mark, now = int(sys.argv[1]), int(sys.argv[2])
try:
    columns = [l.strip() for l in open("/tmp/magento-fake-not-null") if l.strip()]
except FileNotFoundError:
    columns = []
print(json.dumps({
    "patches_after": [f"Fake\\Patch\\Data\\P{i}" for i in range(mark + 1, now + 1)],
    "undeclared_not_null": columns,
    "recurring_missing": [],
    "config_changed": 0,
}))
PY
    ;;
  themes)
    echo '{"missing": []}' ;;
  *) exit 64 ;;
esac
