#!/usr/bin/env bash
#
# zdt-arm: run the fleet arms of issue #5 — the ones with no script until now.
#
# bin/zdt-proof proves claims about one Magento install; bin/zdt-fleet checks
# and records; the arms RUN things on the lab fleet: they drive the migration
# end to end, generate the traffic, and print one PASS or FAIL line per
# falsifier so the transcript is the evidence. A run with any FAIL exits 1.
#
# Usage:
#   bin/zdt-arm list
#   bin/zdt-arm arm1 [-n|-y]
#   bin/zdt-arm arm2 [-n|-y]
#   bin/zdt-arm arm3 [-n|-y]
#   bin/zdt-arm arm4 [-n|-y]
#   bin/zdt-arm restore-snapshot /path/on/the/admin/node [-n|-y]
#
# -n prints the whole plan and runs nothing. Without -y the arm shows the
# plan and asks before its first remote write; without a terminal to answer,
# it stops (2) rather than guessing. restore-snapshot is destructive on the
# primary and follows the same rule.
#
# Every remote command runs over ssh with BatchMode and normal host-key
# checking (never off — bin/check-structure refuses that), is echoed before
# it runs, and any secret in it is echoed as ***. The connection details all
# come from the environment, never from arguments, so no password lands in a
# shell history or a transcript. The hosts have no defaults: a missing one
# stops the arm by name rather than aiming at a guess.
#
# Environment:
#   ZDT_WEB_HOSTS     comma-separated host names of the web nodes (>= 3)
#   ZDT_NEW_NODE      the always-new node (one of ZDT_WEB_HOSTS)
#   ZDT_ADMIN_NODE    the node that runs Magento's commands and the
#                     snapshot; must be ZDT_NEW_NODE — the migration runs
#                     from current, so it must run on the node that carries
#                     the new release (a split is refused, naming both)
#   ZDT_LB_URL        the load balancer's base URL (http://…)
#   ZDT_NODE_URLS     comma-separated per-node base URLs, same order as
#                     ZDT_WEB_HOSTS (traffic to a node directly, so a
#                     refusing node is attributed to that node)
#   ZDT_RELEASE_TARBALL  path on the control machine of the new release
#   ZDT_LABEL_NEW / ZDT_LABEL_OLD   release directory names under
#                     ZDT_RELEASES_DIR (default /var/www/magento/releases);
#                     ZDT_LABEL_OLD must already be deployed on every node
#   ZDT_ENV_PHP       path of each node's env.php (e.g.
#                     /var/www/magento/current/app/etc/env.php)
#   ZDT_DB_HOST / ZDT_DB_USER / ZDT_DB_PASSWORD / ZDT_DB_NAME
#                     the PRIMARY's connection, for the snapshot
#   ZDT_SNAPSHOT_DIR  where the admin node keeps snapshots (default
#                     /var/www/magento/zdt-snapshots)
#   ZDT_RATE          requests per second per target (default 2, max 20)
#   ZDT_DURATION      seconds of traffic per phase (default 120, max 600)
#   ZDT_GUARD_PATTERN extended regex; a response body matching it is logged
#                     as a guard message (e.g. 'Please refresh|config was
#                     changed|Setup must be run')
#   ZDT_CATEGORY_PATH / ZDT_PRODUCT_PATH
#                     paths of a real category and product page (e.g.
#                     /mens.html, /products/gt.html). No default: a guessed
#                     path a stock store does not serve would record every
#                     target as refusing, so the arm asks for them by name
#   ZDT_TOUCHED_TABLES  comma-separated tables to checksum after the lag
#                     reaches zero (default catalog_product_entity)
#   Arm 3 only — the crossing needs the lab's own breaking change, never a
#   guess; a missing one stops arm3 by name:
#   ZDT_RELEASE_ADDITIVE / ZDT_LABEL_ADDITIVE
#                     the additive CONTROL release (adds only): old servers
#                     with the flag on must serve without a guard message
#   ZDT_RELEASE_BREAKING / ZDT_LABEL_BREAKING
#                     the BREAKING release: renames or drops a column the old
#                     code reads — the evidence leg (arm3) and the release
#                     whose outage arm4 measures
#   ZDT_READ_PATH     arm3 only: a route that really reads that column or
#                     table (e.g. a product page reading the column). The
#                     first old-server failure across the breaking release
#                     must name it
#   ZDT_SCHEMA_OBJECT the renamed or dropped column/table name; falsifier 3
#                     greps the first old-server failure's body for it
#   ZDT_RUN_DIR       where this run's evidence lands (default
#                     local.d/zdt-arm/<run>-<arm>/ under the current dir):
#                     the transcript the arm writes itself (transcript.log),
#                     the platform facts (platform.json), the replica gate's
#                     readings, the traffic logs, checksums and the reports
#   ZDT_FLEET_BIN     path of bin/zdt-fleet (default beside this script)
#
# The replica connection (ZDT_PRIMARY_* / ZDT_REPLICA_*) belongs to
# bin/zdt-fleet, which the arms call as their gate; see its --help.
#
# Exit codes: 0 pass; 1 the run failed (a FAIL line); 2 the run never
# happened: missing settings, a declined plan, a refused gate, a failed
# snapshot. Nothing here connects to any server during the tests, and no
# test uses a live server; the arms are built for the lab described in
# docs/zero-downtime-proofs.md.

set -euo pipefail

here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
export ARM_DIR="$here/zdt-arm.d"

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0"
    exit 0
fi
if [[ $# -eq 0 ]]; then
    # A runner called without arguments is a mistake, not a request for help:
    # exit 2 ("the run never happened"), never the 0 a script would log as ok.
    sed -n '2,/^[^#]/{/^#/s/^# \{0,1\}//p}' "$0" >&2
    echo "zdt-arm: usage: bin/zdt-arm arm1|arm2|restore-snapshot [-n|-y] (see list)" >&2
    exit 2
fi

if [[ $1 == list ]]; then
    for f in "$ARM_DIR"/*.sh; do
        [[ $f == "$ARM_DIR/lib.sh" ]] && continue
        name=$(basename "$f" .sh)
        printf '%-12s %s\n' "$name" "$(sed -n 's/^# summary: //p' "$f")"
    done
    printf '%-12s %s\n' "restore-snapshot" "put a snapshot back on the primary (destructive)"
    exit 0
fi

arm="$1"
shift
case "$arm" in
    arm1|arm2|arm3|arm4)
        script="$ARM_DIR/$arm.sh"
        # An arm name is a file name, never a path — as in bin/zdt-proof.
        [[ -f $script ]] || { echo "zdt-arm: no arm named $arm; see zdt-arm list" >&2; exit 2; }
        exec bash "$script" "$@" ;;
    restore-snapshot)
        # shellcheck source=/dev/null disable=SC1091  # lib.sh sits beside this runner
        source "$ARM_DIR/lib.sh"
        require_env
        target=""
        opts=()
        for a in "$@"; do
            case "$a" in
                -n|-y) opts+=("$a") ;;
                *) target="$a" ;;
            esac
        done
        parse_common_flags ${opts[@]+"${opts[@]}"}
        restore_snapshot "$target"
        ;;
    *)
        echo "zdt-arm: '$arm' is not an arm; see zdt-arm list" >&2
        exit 2 ;;
esac
