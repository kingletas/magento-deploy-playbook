#!/usr/bin/env python3
"""A tamper-evident, append-only audit log of deploys, as JSON lines.

Each record carries the SHA-256 of the record before it, so editing, removing
or reordering any line breaks every hash after it and `verify` says where.

  bin/audit-log append --path FILE [--forward "CMD ARG..."]   a record on stdin
  bin/audit-log verify --path FILE
  bin/audit-log evidence --path FILE --release ID --out DIR
  bin/audit-log phases --path FILE --release ID [--json]      how long each phase took
  bin/audit-log postmortem --path FILE --release ID --out FILE  a draft, when the last run failed

The chain proves the log has not been changed since it was written. It does not
stop someone with write access from replacing the whole file, so forward each
record to a store you cannot rewrite, such as syslog or object-locked storage.
"""
from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import shlex
import subprocess
import sys
from pathlib import Path

GENESIS = "0" * 64
SCHEMA = 1
STAMP = "%Y-%m-%dT%H:%M:%SZ"

# A phase is the stretch from the record that opens it to the first record after it that
# closes it, so a deploy's timings are read from its own records and nothing else.
PHASES = (
    ("deploy", "deploy.started", ("deploy.finished", "deploy.failed")),
    ("build", "build.started", ("build.succeeded",)),
    ("upload", "upload.started", ("upload.succeeded",)),
    ("cutover", "cutover.started", ("cutover.succeeded",)),
    ("setup:upgrade", "upgrade.started", ("upgrade.succeeded", "upgrade.failed")),
    ("maintenance", "maintenance.enabled", ("maintenance.disabled",)),
)


class ChainError(Exception):
    """The log is not a valid chain; carries the 1-based line number."""

    def __init__(self, line: int, reason: str) -> None:
        super().__init__(f"line {line}: {reason}")
        self.line = line


def record_hash(record: dict) -> str:
    """SHA-256 of the record's canonical JSON, excluding its own hash."""
    body = {k: v for k, v in record.items() if k != "hash"}
    canonical = json.dumps(body, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def read_chain(path: Path) -> list[dict]:
    """Every record in order, raising ChainError at the first broken link."""
    records: list[dict] = []
    if not path.exists():
        return records
    previous = GENESIS
    with path.open(encoding="utf-8") as handle:
        for number, line in enumerate(handle, 1):
            if not line.strip():
                raise ChainError(number, "blank line")
            try:
                record = json.loads(line)
            except json.JSONDecodeError as exc:
                raise ChainError(number, f"not JSON ({exc.msg})") from exc
            if not isinstance(record, dict):
                raise ChainError(number, "not a JSON object")
            if record.get("seq") != number:
                raise ChainError(number, f"seq is {record.get('seq')!r}, expected {number}")
            if record.get("prev_hash") != previous:
                raise ChainError(number, "prev_hash does not match the record before it")
            if record.get("hash") != record_hash(record):
                raise ChainError(number, "hash does not match the record's contents")
            previous = record["hash"]
            records.append(record)
    return records


def append(path: Path, payload: dict, forward: str) -> dict:
    """Chain payload onto the log under an exclusive lock and return the record."""
    reserved = {"schema", "seq", "prev_hash", "hash", "recorded_at"} & payload.keys()
    if reserved:
        raise ValueError(f"the record may not set {', '.join(sorted(reserved))}")
    path.parent.mkdir(parents=True, exist_ok=True)
    lock_path = path.with_name(path.name + ".lock")
    with lock_path.open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        chain = read_chain(path)
        record = {
            "schema": SCHEMA,
            "seq": len(chain) + 1,
            "recorded_at": dt.datetime.now(dt.timezone.utc).strftime(STAMP),
            "prev_hash": chain[-1]["hash"] if chain else GENESIS,
            **payload,
        }
        record["hash"] = record_hash(record)
        line = json.dumps(record, sort_keys=True, ensure_ascii=False) + "\n"
        with path.open("a", encoding="utf-8") as handle:
            handle.write(line)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(path, 0o600)
    if forward:
        subprocess.run(shlex.split(forward), input=line, text=True, check=True, timeout=60)
    return record


def release_records(path: Path, release: str) -> tuple[list[dict], list[dict]]:
    """The verified chain, and the records in it that belong to the release."""
    chain = read_chain(path)
    selected = [r for r in chain if r.get("release") == release]
    if not selected:
        raise LookupError(f"no records for release {release!r} in {path}")
    return chain, selected


def last_run(selected: list[dict]) -> list[dict]:
    """The release's records from its last deploy.started on: a release deployed twice is timed by its last run."""
    starts = [i for i, r in enumerate(selected) if r.get("event") == "deploy.started"]
    return selected[starts[-1]:] if starts else selected


def seconds_between(start: dict, end: dict) -> int | None:
    """Whole seconds from one record to another, or None when either time cannot be read."""
    try:
        began = dt.datetime.strptime(start["recorded_at"], STAMP).replace(tzinfo=dt.timezone.utc)
        ended = dt.datetime.strptime(end["recorded_at"], STAMP).replace(tzinfo=dt.timezone.utc)
    except (KeyError, TypeError, ValueError):
        return None
    return int((ended - began).total_seconds())


def phase_spans(selected: list[dict]) -> list[dict]:
    """Each phase of the release's last run: when it started, when it ended, and the seconds between.

    A phase the run never opened has no times. One it opened and never closed has a start and no
    end, which is what a deploy that stopped there, or a store still in maintenance, looks like.
    """
    run = last_run(selected)
    spans = []
    for name, opens, closes in PHASES:
        start = next((r for r in run if r.get("event") == opens), None)
        end = None
        if start is not None:
            end = next((r for r in run if r["seq"] > start["seq"] and r.get("event") in closes), None)
        spans.append({
            "phase": name,
            "started": start.get("recorded_at") if start else None,
            "ended": end.get("recorded_at") if end else None,
            "ended_by": end.get("event") if end else None,
            "seconds": seconds_between(start, end) if start and end else None,
        })
    return spans


def phases_text(release: str, spans: list[dict]) -> str:
    """The spans as a table for a terminal."""
    lines = [f"release {release}", f"{'phase':<15}{'started':<22}{'ended':<22}seconds"]
    for span in spans:
        if span["started"] is None:
            lines.append(f"{span['phase']:<15}not recorded")
        elif span["ended"] is None:
            lines.append(f"{span['phase']:<15}{span['started']:<22}{'not closed':<22}-")
        else:
            seconds = "?" if span["seconds"] is None else span["seconds"]
            lines.append(f"{span['phase']:<15}{span['started']:<22}{span['ended']:<22}{seconds}")
    return "\n".join(lines) + "\n"


def maintenance_words(selected: list[dict], spans: list[dict]) -> str:
    """What the summary says about the maintenance window, from the records alone."""
    window = next(span for span in spans if span["phase"] == "maintenance")
    if window["started"] is None:
        return "no"
    if window["ended"] is not None:
        return f"yes, {window['seconds']} s, from {window['started']} to {window['ended']}"
    run = last_run(selected)
    if any(r.get("event") in ("cutover.succeeded", "deploy.finished") for r in run):
        # A deploy that went on to succeed did take the page down; a playbook from before
        # maintenance.disabled existed just never wrote when.
        return f"yes, from {window['started']}; its end was not recorded"
    return f"yes, from {window['started']}, and no end is recorded: the store may still be in maintenance"


def write_evidence(path: Path, release: str, out: Path) -> Path:
    """Write the release's records, the chain position and a summary to out."""
    chain, selected = release_records(path, release)
    out.mkdir(parents=True, exist_ok=True)
    files = {
        "audit.jsonl": "".join(json.dumps(r, sort_keys=True, ensure_ascii=False) + "\n" for r in selected),
        "chain.txt": chain_text(path, chain, selected),
        "summary.md": summary_markdown(release, selected),
    }
    for name, text in files.items():
        (out / name).write_text(text, encoding="utf-8")
    sums = "".join(
        f"{hashlib.sha256((out / name).read_bytes()).hexdigest()}  {name}\n" for name in sorted(files)
    )
    (out / "SHA256SUMS").write_text(sums, encoding="utf-8")
    return out


def chain_text(path: Path, chain: list[dict], selected: list[dict]) -> str:
    """Where the release's records sit in the full chain, so a copy can be checked against it."""
    lines = [
        f"log: {path}",
        f"records in log: {len(chain)}",
        f"head hash: {chain[-1]['hash']}",
        "chain verified: yes",
        "",
        "seq  prev_hash  hash  event",
    ]
    lines += [f"{r['seq']}  {r['prev_hash']}  {r['hash']}  {r.get('event', '')}" for r in selected]
    return "\n".join(lines) + "\n"


def summary_markdown(release: str, selected: list[dict]) -> str:
    """A reviewer's one-page account of the release, built only from its records."""
    def first(event: str) -> dict:
        return next((r for r in selected if r.get("event") == event), {})

    spans = phase_spans(selected)
    started = first("deploy.started")
    build = first("build.succeeded")
    approval = first("approval.verified")
    backup = first("backup.succeeded")
    verified = first("deploy.verified")
    finished = first("deploy.finished")
    actor = started.get("actor", {})
    rows = [
        ("Environment", started.get("env_name", "not recorded")),
        ("Deployed by", (f"{actor.get('git_email', 'unknown')} as {actor.get('os_user', 'unknown')} "
                         f"from {actor.get('control_host', 'unknown')}")),
        ("Started", started.get("recorded_at", "not recorded")),
        ("Commit", build.get("commit", "not recorded")),
        ("Artefact SHA-256", build.get("artefact_sha256", "not recorded")),
        ("Approved by", f"{approval.get('signer')} (tag {approval.get('tag')})" if approval else "no approval recorded"),
        ("Backup", backup.get("backup_id", "none taken")),
        ("Maintenance window", maintenance_words(selected, spans)),
        ("Finished", finished.get("recorded_at", "not recorded: the deploy did not complete")),
        ("Verified", verified.get("recorded_at", "not recorded: verify-deploy.yml has not passed")),
    ]
    table = "\n".join(f"| {k} | {v} |" for k, v in rows)
    events = "\n".join(f"- `{r['recorded_at']}` {r.get('event')}" for r in selected)
    phases = "\n".join(
        f"| {s['phase']} | {s['started'] or 'not recorded'} | "
        f"{s['ended'] or ('not closed' if s['started'] else '')} | "
        f"{'' if s['seconds'] is None else s['seconds']} |"
        for s in spans
    )
    return (
        f"# Release {release}\n\n"
        "Built from the audit log records for this release. `SHA256SUMS` covers every file here, "
        "and `chain.txt` places each record in the full log.\n\n"
        f"| | |\n|---|---|\n{table}\n\n"
        "## Phases\n\n"
        "From the release's last run. Times are when each record was written, to the second.\n\n"
        f"| Phase | Started | Ended | Seconds |\n|---|---|---|---|\n{phases}\n\n"
        f"## Events\n\n{events}\n"
    )


# The records that say a run went wrong. A run with none of them gets no postmortem.
FAILURES = ("backup.failed", "upgrade.failed", "health.failed", "rollback.refused", "deploy.rolled_back",
            "deploy.failed")
# The envelope every record carries; a timeline line shows only what the event adds.
ENVELOPE = {"schema", "seq", "recorded_at", "prev_hash", "hash", "event", "env_name", "release", "actor"}


def what_went_wrong(record: dict) -> str:
    """One failure record as a sentence, from its own fields only."""
    event = record.get("event")
    if event == "backup.failed":
        return f"The backup failed, so the deploy stopped: {record.get('error', 'no error recorded')}"
    if event == "upgrade.failed":
        return (f"setup:upgrade failed on {record.get('magento_host', 'a host not recorded')} after the switch, "
                f"and the store was left in maintenance: {record.get('error', 'no error recorded')}")
    if event == "health.failed":
        return (f"The health check failed on {', '.join(record.get('hosts') or ['hosts not recorded'])} "
                f"for {', '.join(record.get('paths') or ['paths not recorded'])}; rollback was "
                f"{record.get('rollback', 'not recorded')}")
    if event == "rollback.refused":
        return (f"Going back to {record.get('to_release', 'a release not recorded')} was refused: "
                + "; ".join(record.get("reasons") or ["no reason recorded"]))
    if event == "deploy.rolled_back":
        recovered = {True: "passed", False: "did not pass"}.get(record.get("recovered"), "has no recorded result for")
        return (f"{record.get('to_release', 'The release before')} is live again "
                f"(trigger: {record.get('trigger', 'not recorded')}), and it {recovered} its health check")
    step = f" at the step '{record['step']}'" if record.get("step") else ""
    return (f"The deploy stopped in its {record.get('phase', 'unrecorded')} phase{step}: "
            f"{record.get('error', 'no error recorded')}")


def postmortem_markdown(release: str, selected: list[dict]) -> str | None:
    """A postmortem draft of the release's last run, or None when nothing in it went wrong.

    Every line comes from a record. What the records cannot say, the cause and
    what to change, is left as headings for a person.
    """
    run = last_run(selected)
    failures = [r for r in run if r.get("event") in FAILURES]
    finished = next((r for r in reversed(run) if r.get("event") == "deploy.finished"), {})
    if not failures and finished.get("outcome") != "rolled_back":
        return None
    spans = phase_spans(selected)
    started = next((r for r in run if r.get("event") == "deploy.started"), {})
    build = next((r for r in run if r.get("event") == "build.succeeded"), {})
    backup = next((r for r in run if r.get("event") == "backup.succeeded"), {})
    actor = started.get("actor", {})
    rows = [
        ("Environment", started.get("env_name", run[0].get("env_name", "not recorded"))),
        ("Deployed by", (f"{actor.get('git_email', 'unknown')} as {actor.get('os_user', 'unknown')} "
                         f"from {actor.get('control_host', 'unknown')}")),
        ("Started", started.get("recorded_at", "not recorded")),
        ("Last record", run[-1].get("recorded_at", "not recorded")),
        ("Commit", build.get("commit", "not recorded")),
        ("Backup", backup.get("backup_id", "none taken")),
        ("Maintenance window", maintenance_words(selected, spans)),
        ("Ended", finished.get("outcome", "no deploy.finished: the run stopped before its end")),
    ]
    table = "\n".join(f"| {k} | {v} |" for k, v in rows)
    wrong = "\n".join(f"- `{r['recorded_at']}` {what_went_wrong(r)}" for r in failures) or \
        "- No failure record; `deploy.finished` says the deploy was rolled back."

    def detail(record: dict) -> str:
        extra = {k: v for k, v in record.items() if k not in ENVELOPE}
        return ("  " + ", ".join(f"{k}: {json.dumps(v, ensure_ascii=False)}" for k, v in sorted(extra.items()))) \
            if extra else ""

    timeline = "\n".join(f"- `{r['recorded_at']}` {r.get('event')}{detail(r)}" for r in run)
    phases = "\n".join(
        f"| {s['phase']} | {s['started'] or 'not recorded'} | "
        f"{s['ended'] or ('not closed' if s['started'] else '')} | "
        f"{'' if s['seconds'] is None else s['seconds']} |"
        for s in spans
    )
    return (
        f"# Postmortem draft: release {release}\n\n"
        "Written by `bin/audit-log postmortem` from the audit log's records for this release's last run, "
        "and from nothing else. Times are when each record was written, in UTC. The last three sections "
        "are for a person.\n\n"
        f"| | |\n|---|---|\n{table}\n\n"
        f"## What went wrong, as recorded\n\n{wrong}\n\n"
        f"## Timeline\n\n{timeline}\n\n"
        f"## Phases\n\n| Phase | Started | Ended | Seconds |\n|---|---|---|---|\n{phases}\n\n"
        "## Why it happened\n\n"
        "## What we change\n\n"
        "## Who follows up, and by when\n"
    )


def write_postmortem(path: Path, release: str, out: Path) -> Path | None:
    """Write the draft to OUT when the release's last run went wrong; return OUT, or None when it did not."""
    text = postmortem_markdown(release, release_records(path, release)[1])
    if text is None:
        return None
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text, encoding="utf-8")
    return out


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)
    add = sub.add_parser("append", help="chain a JSON record from stdin onto the log")
    add.add_argument("--path", required=True)
    add.add_argument("--forward", default="", help="a command and arguments that receive the record on stdin")
    check = sub.add_parser("verify", help="check every link in the log")
    check.add_argument("--path", required=True)
    bundle = sub.add_parser("evidence", help="write one release's records and a summary")
    bundle.add_argument("--path", required=True)
    bundle.add_argument("--release", required=True)
    bundle.add_argument("--out", required=True)
    timings = sub.add_parser("phases", help="how long each phase of one release's last run took")
    timings.add_argument("--path", required=True)
    timings.add_argument("--release", required=True)
    timings.add_argument("--json", action="store_true", help="the spans as JSON, for another program")
    draft = sub.add_parser("postmortem", help="a postmortem draft of one release's last run, when it failed")
    draft.add_argument("--path", required=True)
    draft.add_argument("--release", required=True)
    draft.add_argument("--out", required=True)
    args = parser.parse_args(argv)
    path = Path(args.path).expanduser()

    try:
        if args.command == "append":
            payload = json.load(sys.stdin)
            if not isinstance(payload, dict):
                raise ValueError("the record on stdin must be a JSON object")
            record = append(path, payload, args.forward)
            print(record["hash"])
        elif args.command == "verify":
            chain = read_chain(path)
            if not chain:
                print(f"{path}: no records")
                return 0
            print(f"{path}: {len(chain)} records, chain intact, head {chain[-1]['hash']}")
        elif args.command == "phases":
            spans = phase_spans(release_records(path, args.release)[1])
            if args.json:
                print(json.dumps({"release": args.release, "phases": spans}, sort_keys=True))
            else:
                print(phases_text(args.release, spans), end="")
        elif args.command == "postmortem":
            out = write_postmortem(path, args.release, Path(args.out).expanduser())
            print(f"postmortem draft for {args.release}: {out}" if out
                  else f"no postmortem: nothing in the last run of {args.release} went wrong")
        else:
            out = write_evidence(path, args.release, Path(args.out).expanduser())
            print(f"evidence for {args.release}: {out}")
    except ChainError as exc:
        print(f"{path}: chain broken at {exc}. Nothing after that line can be trusted.", file=sys.stderr)
        return 2
    except (ValueError, LookupError, OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        print(f"audit-log {args.command}: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
