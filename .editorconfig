# Load-bearing rather than cosmetic: a stray tab in YAML is a parse error.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Make requires real tabs in recipes.
[Makefile*]
indent_style = tab

[*.cfg]
indent_style = space
indent_size = 4

[*.php]
indent_style = space
indent_size = 4

# Payloads copied verbatim to the fleet. Do not reformat them -- they are
# artefacts, and a whitespace change would ship.
[files/**]
trim_trailing_whitespace = false
insert_final_newline = false

# Generated.
[inventory/docker/hosts]
trim_trailing_whitespace = false
