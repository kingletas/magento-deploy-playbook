#!/bin/bash
# Stands in for the PHP CLI, and it has to DISPATCH rather than blindly forward.
#
# Four callers invoke php with different scripts:
#   php bin/magento <subcommand>          the deploy tasks
#   php .../magento-isolated.php ...      the same, run apart from the live cache
#   php .../magento-db-guard.php ...      the rollback guard's database reads
#   php .../magento-db-snapshot.php ...   the lock rehearsal's production snapshot
#   php /usr/local/bin/composer help ...  the community.general.composer module,
#                                         which shells out as `php composer ...`
#
# An earlier version dropped $1 and sent everything to the Magento fake, so the
# module's `composer help install --format=json` probe returned "ok: help
# install" and the module died in from_json with "Expecting value: line 1".
script="${1:-}"; shift 2>/dev/null || true
echo "[fake-php] ${script} $*" >> /tmp/build-log 2>/dev/null || true

case "${script}" in
    *composer*) exec /usr/local/bin/composer "$@" ;;
    # php magento-isolated.php <release> [--require-isolation] -- <command>
    *magento-isolated*)
        cd "${1:?}" || exit 66
        while [ $# -gt 0 ] && [ "$1" != "--" ]; do shift; done
        shift
        exec /usr/local/bin/magento-fake "$@" ;;
    *magento-db-guard*) exec /usr/local/bin/magento-db-guard-fake "$@" ;;
    # php magento-db-snapshot.php <release> <stats.json> <dump.sql>
    *magento-db-snapshot*)
        printf '{"version": "11.4.10-MariaDB", "row_format": "dynamic", "tables": {}}\n' > "$2"
        printf -- '-- fake schema dump\n' > "$3"
        echo '{"tables": 0, "seeded": 0}' ;;
    *magento*)  exec /usr/local/bin/magento-fake "$@" ;;
    *)
        echo "[fake-php] unrecognised script: ${script}" >> /tmp/build-log 2>/dev/null || true
        exit 0
        ;;
esac
